BASE_URL = "http://localhost:8000"

# Paramètres pour l'envoi de mail
SMTP_HOST = "0.0.0.0"
SMTP_PORT = 587
SMTP_USER = "your_smtp_user"
SMTP_PASS = "your_smtp_pass"
# values: 'ssl'|'starttls'|'none'
SMTP_SECURE = "starttls"
SMTP_FROM = "no-reply@yaka.local"

# 'true' crée les comptes de démonstration publics (Admin123 / Demo1234) et active
# POST /demo/reset : jamais sur une instance contenant de vraies données
DEMO_MODE = "false"

# values: 'development'|'production' (toute autre valeur vaut production ;
# 'development' active /docs et les origines http://localhost et file://)
ENVIRONMENT = "production"

# Paramètres pour l'utilisation de l'IA
OPENAI_API_KEY=sk-proj-bim-bam-boum
OPENAI_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-nano
MODEL_TEMPERATURE=

# Admin API key for board management operations
# Leave empty to disable /admin, otherwise >= 32 characters. Generate with: openssl rand -hex 32
YAKA_ADMIN_API_KEY=

# JWT Secret (REQUIRED, >= 32 characters) - generate with: openssl rand -hex 32
JWT_SECRET=

# Mot de passe de l'administrateur initial (optionnel, utilisé seulement à la création de la
# base). Vide : mot de passe aléatoire affiché une seule fois dans les logs, à changer à la
# première connexion
DEFAULT_ADMIN_PASSWORD=

# Limitation de débit (vide = défaut). Par IP : connexion et changement de mot de passe
# (10/minute), demande de réinitialisation (5/minute) ; par compte : tentatives de connexion
# et de changement de mot de passe (5 per 15 minutes). Plusieurs limites séparées par ";".
# Une valeur invalide empêche le démarrage.
LOGIN_RATE_LIMIT=
PASSWORD_RESET_RATE_LIMIT=
LOGIN_ACCOUNT_RATE_LIMIT=
# Pilotage vocal : requêtes par utilisateur (vide = 20/minute) et appels LLM simultanés pour
# tout le backend (vide = 4, au-delà les requêtes sont refusées)
VOICE_CONTROL_RATE_LIMIT=
LLM_MAX_CONCURRENT_CALLS=

ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:4173,https://localhost.yajusta.fr
# Par défaut : capacitor://localhost,ionic://localhost, plus http://localhost en
# développement (MOBILE_ORIGINS vide ou absente). Une valeur remplace ce défaut : n'y mettre
# http://localhost qu'en connaissance de cause (toute page servie sur ce poste
# serait autorisée). "," : aucune origine mobile
# MOBILE_ORIGINS=capacitor://localhost,ionic://localhost

# FORWARDED_ALLOW_IPS (proxys autorisés à transmettre l'IP client, 127.0.0.1 par défaut)
# est lu par uvicorn dans l'environnement du processus, pas dans ce fichier : l'exporter
# avant de lancer uvicorn (ou utiliser --forwarded-allow-ips)
