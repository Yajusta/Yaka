BASE_URL = "http://localhost:8000"

# Paramètres pour l'envoi de mail
SMTP_HOST = "0.0.0.0"
SMTP_PORT = 587
SMTP_USER = "your_smtp_user"
SMTP_PASS = "your_smtp_pass"
SMTP_SECURE = "starttls"  # values: 'ssl'|'starttls'|'none'
SMTP_FROM = "no-reply@yaka.local"

DEMO_MODE = "false"

# values: 'development'|'production' (toute autre valeur vaut production ;
# 'development' active /docs et les origines http://localhost et file://)
ENVIRONMENT = "production"

# Paramètres pour l'utilisation de l'IA
OPENAI_API_KEY=sk-proj-bim-bam-boum
OPENAI_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-nano
MODEL_TEMPERATURE=

# Admin API key for board management operations
# Leave empty to disable /admin, otherwise >= 32 characters. Generate with: openssl rand -hex 32
YAKA_ADMIN_API_KEY=

# JWT Secret (REQUIRED, >= 32 characters) - generate with: openssl rand -hex 32
JWT_SECRET=

ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:4173,https://localhost.yajusta.fr
# Par défaut : capacitor://localhost,ionic://localhost, plus http://localhost en
# développement. Définir MOBILE_ORIGINS remplace ce défaut : n'y mettre
# http://localhost qu'en connaissance de cause (toute page servie sur ce poste
# serait autorisée)
# MOBILE_ORIGINS=capacitor://localhost,ionic://localhost