COMPOSE_PROJECT_NAME=yaka

# Kanban Application Environment Variables
# Ports hote des frontends (defaut 3000/3001 si non definis)
FRONTEND_DESKTOP_PORT=3000
FRONTEND_MOBILE_PORT=3001
BASE_URL=http://localhost:3000
BASE_URL_MOBILE=http://localhost:3001

# Backend Configuration
## Mail server
SMTP_HOST=0.0.0.0
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_SECURE=starttls
SMTP_FROM=no-reply@yaka.local

## AI features (leave empty to disable)
OPENAI_API_KEY=sk-proj-bim-bam-boum
OPENAI_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-nano
MODEL_TEMPERATURE=

# Admin API key for board management operations (leave empty to disable /admin, otherwise >= 32 characters)
# Generate with: openssl rand -hex 32
YAKA_ADMIN_API_KEY=

# Initial administrator password (optional, used only when the database is created).
# Leave empty to generate a random one, printed once in the backend logs and to be changed at first login.
DEFAULT_ADMIN_PASSWORD=

# Rate limiting of login, password change and password reset (per client IP, plus login
# and password change attempts per account). Leave empty for the defaults: 10/minute
# (login and password change), 5/minute, 5 per 15 minutes. Several limits can be combined
# with ";" (e.g. "5 per 15 minutes;20/day"). An invalid value stops the backend at startup.
LOGIN_RATE_LIMIT=
PASSWORD_RESET_RATE_LIMIT=
LOGIN_ACCOUNT_RATE_LIMIT=
# Voice control: requests per user (empty = 20/minute) and simultaneous LLM calls for the
# whole backend (empty = 4, beyond that requests are refused immediately).
VOICE_CONTROL_RATE_LIMIT=
LLM_MAX_CONCURRENT_CALLS=
# Extra CORS origins, comma-separated (BASE_URL and BASE_URL_MOBILE are always allowed).
ALLOWED_ORIGINS=
# Mobile app origins; empty = capacitor://localhost,ionic://localhost (plus http://localhost
# in development). A value replaces this default; "," allows no mobile origin at all.
MOBILE_ORIGINS=
# Behind a reverse proxy, list its IP(s) or network(s) so the client IP is read from
# X-Forwarded-For (otherwise every client shares the proxy's IP and its rate limits).
# In Docker the proxy is seen from the bridge gateway or its own container, never 127.0.0.1:
# e.g. the gateway IP (docker network inspect <project>_yaka-network) or the network CIDR,
# with the backend port published on 127.0.0.1 only. Never use * if the backend port is exposed.
# Empty = 127.0.0.1.
FORWARDED_ALLOW_IPS=

# Frontend Configuration
# Backend URL as seen by the browsers. Must be absolute (http(s)://host[:port]): its origin
# is added to the frontend Content-Security-Policy (connect-src), otherwise it is blocked.
API_BASE_URL=http://localhost:8000

# Demo Mode (use only for demo purposes)
# true creates the public demo accounts (admin: DEFAULT_ADMIN_PASSWORD or Admin123, others: Demo1234) and
# enables POST /demo/reset: never on an instance holding real data.
DEMO_MODE=false

# Default language
DEFAULT_LANGUAGE=en

# JWT Secret (REQUIRED, >= 32 characters) - generate with: openssl rand -hex 32
JWT_SECRET=

# values: 'development'|'production' (any other value means production;
# 'development' enables /docs and the http://localhost and file:// origins).
# Keep comments on their own line: `docker run --env-file` keeps inline ones.
ENVIRONMENT=production


# Optional: Database Configuration (if using PostgreSQL)
# DATABASE_URL=postgresql://kanban_user:kanban_password@db:5432/kanban

VITE_BASE_PATH=/m/
VITE_VOICE_TRANSCRIPT_LIMIT=500